[Unit]
Description=EGR CRM registry collector
After=network-online.target egrcrm-web.service
Wants=network-online.target

[Service]
Type=simple
User=egrcrm
Group=egrcrm
WorkingDirectory=/opt/egrcrm/current
EnvironmentFile=/etc/egrcrm/egrcrm.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/egrcrm/current/.venv/bin/python manage.py egr_worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/egrcrm
MemoryAccounting=true

[Install]
WantedBy=multi-user.target
